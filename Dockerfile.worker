# The always-on TxWhy worker (usage counters + mainnet failure index). Runs on Railway.
# The website itself is deployed to Vercel and does not use this file.
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src/lib ./src/lib
COPY worker ./worker
EXPOSE 8787
CMD ["npx", "tsx", "worker/index.ts"]
